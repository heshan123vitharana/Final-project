# ========================================
# FRONTEND ENVIRONMENT VARIABLES
# ========================================
# Copy this file and fill in your actual values
# For Vercel: Add these in Project Settings > Environment Variables
# ========================================

# Backend API URL
VITE_API_BASE_URL=https://your-backend-app.railway.app

# Google Maps API Key (if using maps)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ========================================
# NOTES:
# ========================================
# 1. Never commit this file with real values to Git
# 2. Update VITE_API_BASE_URL after deploying backend to Railway
# 3. After changing env vars in Vercel, trigger a new deployment
# 4. All Vite env vars must start with VITE_ prefix
# ========================================
