# ========================================
# BACKEND ENVIRONMENT VARIABLES
# ========================================
# Copy this file and fill in your actual values
# For Railway: Add these in the Variables tab
# ========================================

# Server Configuration
NODE_ENV=production
PORT=3000

# Database Configuration (TiDB Cloud)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_USER=your-tidb-username-here
DB_PASSWORD=your-tidb-password-here
DB_NAME=paddy_management
DB_PORT=4000

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-to-random-string
JWT_EXPIRES_IN=7d

# CORS Configuration
FRONTEND_URL=https://your-app-name.vercel.app

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Email Configuration (Optional - if using email features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ========================================
# NOTES:
# ========================================
# 1. Never commit this file with real values to Git
# 2. Generate a strong JWT_SECRET using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Update FRONTEND_URL after deploying to Vercel
# 4. For Gmail SMTP, use App Password, not your regular password
# ========================================
